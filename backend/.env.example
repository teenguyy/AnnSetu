# Copy to .env and fill in. Every value here is server-only: never expose it to the browser.
ENV=development

# Supavisor pooler, TRANSACTION mode (port 6543). Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
# Only for projects still on the legacy JWT secret; leave empty to verify with the project's JWKS signing keys.
SUPABASE_JWT_SECRET=

CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_SITE_URL=http://localhost:3000
IP_HASH_SALT=generate-a-long-random-string

# Optional: shared rate limits across workers (recommended in production)
REDIS_URL=

# AI document review + chatbot (phase 14)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email: Resend, or SMTP. With neither, email is disabled (in-app notifications still work).
RESEND_API_KEY=
EMAIL_FROM=AnnSetu <no-reply@your-domain>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

OSRM_URL=https://router.project-osrm.org
SENTRY_DSN=

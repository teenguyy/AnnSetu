# AnnSetu backend configuration. Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://wwnkyukqiibbzqqbfsxp.supabase.co
# Publishable (anon) key: the same public key the website uses
SUPABASE_ANON_KEY=sb_publishable_...
# Secret: from https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Comma-separated list of sites allowed to call the API
ALLOWED_ORIGINS=https://annsetu-inky.vercel.app,http://localhost:8080
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

<?xml version="1.0" encoding="utf-8"?>
<!-- AnnSetu native launch screen: forest green with the brand mark, shown before Flutter draws. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item android:width="144dp" android:height="144dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>

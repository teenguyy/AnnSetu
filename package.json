{
  "name": "annsetu",
  "version": "1.0.0",
  "private": true,
  "description": "AnnSetu: surplus food redistribution. Static React build + Supabase.",
  "scripts": {
    "build": "esbuild src/home.jsx src/main.jsx --bundle --splitting --format=esm --minify --jsx=automatic --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outdir=assets/js --chunk-names=chunks/[name]-[hash] --log-level=warning",
    "test": "node test/run-tests.js",
    "serve": "npx --yes serve -l 8080 ."
  },
  "dependencies": {
    "gsap": "3.15.1",
    "motion": "14.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
